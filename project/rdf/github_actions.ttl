<https://w3id.org/lmodel/github-actions/GhaWorkflow> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://docs.github.com/en/actions/reference/workflows-and-actions/workflow-syntax"^^xsd:anyURI ;
	skos:altLabel "workflow" ;
	skos:broadMatch "schema:SoftwareSourceCode"^^xsd:anyURI ;
	skos:closeMatch "cdx:workflow"^^xsd:anyURI ;
	skos:exactMatch "gha:Workflow"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_workflow"^^xsd:anyURI ;
	skos:note "SPDX 3.0.1's Build records one run of a build, such as a run of this workflow, so it is a related term and not a close one. The mappings to CycloneDX, SPDX and schema.org are this project's own; a workflow file is code in a repository, of which schema.org's SoftwareSourceCode is the broader term." , "The ref a run checks the file out at belongs to the run, and GitHub's build type records it in provenance as workflow.ref; it is not a fact of the file, so it is not modelled here." ;
	skos:relatedMatch "spdx_build:Build"^^xsd:anyURI ;
	linkml:attributes <https://w3id.org/lmodel/github-actions/permissions> , <https://w3id.org/lmodel/github-actions/workflow_path> , <https://w3id.org/lmodel/github-actions/workflow_repository> , <https://w3id.org/lmodel/github-actions/workflow_uri> ;
	linkml:class_uri "https://w3id.org/lmodel/github-actions/Workflow"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/GhaWorkflow"^^xsd:anyURI ;
	linkml:description "A workflow file in a repository's `.github/workflows` directory: the events that run it, the access its GITHUB_TOKEN gets, and its jobs." ;
	linkml:slot_usage _:c14n12 ;
	linkml:slots <https://w3id.org/lmodel/github-actions/GhaWorkflow_triggers> , <https://w3id.org/lmodel/github-actions/ghaWorkflow__permissions> , <https://w3id.org/lmodel/github-actions/ghaWorkflow__workflow_path> , <https://w3id.org/lmodel/github-actions/ghaWorkflow__workflow_repository> , <https://w3id.org/lmodel/github-actions/ghaWorkflow__workflow_uri> , <https://w3id.org/lmodel/github-actions/jobs> .
