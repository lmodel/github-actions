	linkml:owner <https://w3id.org/lmodel/github-actions/GhaActionInput> ;
	linkml:range <https://w3id.org/lmodel/github-actions/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/github-actions/deprecation_message"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/ghaAction__action_path> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_action"^^xsd:anyURI ;
	skos:prefLabel "action_path" ;
	linkml:description "The metadata file's path from the repository root." ;
	linkml:domain_of <https://w3id.org/lmodel/github-actions/GhaAction> ;
	linkml:owner <https://w3id.org/lmodel/github-actions/GhaAction> ;
	linkml:pattern "^(.+/)?action\\.ya?ml$" ;
	linkml:range <https://w3id.org/lmodel/github-actions/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/github-actions/action_path"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/ghaAction__action_uri> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_action"^^xsd:anyURI ;
	skos:prefLabel "action_uri" ;
	linkml:description "The action's address on its forge without a ref: `https://github.com/<owner>/<repo>`, followed by the directory's path when the action is not at the repository root. A step's `uses` names it as `<owner>/<repo>/<path>@<ref>`." ;
	linkml:domain_of <https://w3id.org/lmodel/github-actions/GhaAction> ;
	linkml:identifier true ;
	linkml:owner <https://w3id.org/lmodel/github-actions/GhaAction> ;
	linkml:range <https://w3id.org/lmodel/github-actions/uri> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/github-actions/action_uri"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/ghaAction__using> a linkml:SlotDefinition ;
