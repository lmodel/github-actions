<https://w3id.org/lmodel/github-actions/GhaBypassActor> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://docs.github.com/en/rest/repos/rules"^^xsd:anyURI ;
	skos:altLabel "bypass actor" ;
	skos:exactMatch "gha:BypassActor"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_rules"^^xsd:anyURI ;
	linkml:attributes <https://w3id.org/lmodel/github-actions/actor_id> , <https://w3id.org/lmodel/github-actions/actor_type> , <https://w3id.org/lmodel/github-actions/bypass_mode> ;
	linkml:class_uri "https://w3id.org/lmodel/github-actions/BypassActor"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/GhaBypassActor"^^xsd:anyURI ;
	linkml:description "An actor who may bypass a ruleset, and when." ;
	linkml:slot_usage _:c14n4 ;
	linkml:slots <https://w3id.org/lmodel/github-actions/ghaBypassActor__actor_id> , <https://w3id.org/lmodel/github-actions/ghaBypassActor__actor_type> , <https://w3id.org/lmodel/github-actions/ghaBypassActor__bypass_mode> .
<https://w3id.org/lmodel/github-actions/GhaDocument> a linkml:ClassDefinition ;
	skos:exactMatch "gha:Document"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/github-actions"^^xsd:anyURI ;
	linkml:attributes <https://w3id.org/lmodel/github-actions/actions> , <https://w3id.org/lmodel/github-actions/required_checks> , <https://w3id.org/lmodel/github-actions/reusable_workflows> , <https://w3id.org/lmodel/github-actions/rulesets> , <https://w3id.org/lmodel/github-actions/workflows> ;
	linkml:class_uri "https://w3id.org/lmodel/github-actions/Document"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/GhaDocument"^^xsd:anyURI ;
	linkml:description "A document that holds the workflows, actions, rulesets and required status checks of one or more repositories." ;
	linkml:slot_usage _:c14n23 ;
	linkml:slots <https://w3id.org/lmodel/github-actions/ghaDocument__actions> , <https://w3id.org/lmodel/github-actions/ghaDocument__required_checks> , <https://w3id.org/lmodel/github-actions/ghaDocument__reusable_workflows> , <https://w3id.org/lmodel/github-actions/ghaDocument__rulesets> , <https://w3id.org/lmodel/github-actions/ghaDocument__workflows> ;
	linkml:tree_root true .
<https://w3id.org/lmodel/github-actions/GhaInput> a linkml:ClassDefinition ;
	skos:closeMatch "schema:PropertyValueSpecification"^^xsd:anyURI ;
	skos:exactMatch "gha:Input"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_core"^^xsd:anyURI ;
	skos:note "The mappings to schema.org are this project's own: an input specifies a value a caller supplies, as schema.org's PropertyValueSpecification specifies the input of an action, whose valueRequired the required field already carries." ;
	linkml:abstract true ;
	linkml:attributes <https://w3id.org/lmodel/github-actions/default> , <https://w3id.org/lmodel/github-actions/input_id> ;
	linkml:children_are_mutually_disjoint true ;
	linkml:class_uri "https://w3id.org/lmodel/github-actions/Input"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/GhaInput"^^xsd:anyURI ;
	linkml:description "An input that a reusable workflow or an action declares, under the key a caller writes in its `with` map." ;
	linkml:mixins <https://w3id.org/lmodel/github-actions/GhaRequiredMixin> ;
	linkml:slot_usage _:c14n9 ;
	linkml:slots <https://w3id.org/lmodel/github-actions/description> , <https://w3id.org/lmodel/github-actions/ghaInput__default> , <https://w3id.org/lmodel/github-actions/ghaInput__input_id> , <https://w3id.org/lmodel/github-actions/ghaRequiredMixin__required> .
<https://w3id.org/lmodel/github-actions/GhaOutput> a linkml:ClassDefinition ;
	skos:exactMatch "gha:Output"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_core"^^xsd:anyURI ;
	linkml:abstract true ;
	linkml:attributes <https://w3id.org/lmodel/github-actions/output_id> ;
	linkml:children_are_mutually_disjoint true ;
	linkml:class_uri "https://w3id.org/lmodel/github-actions/Output"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/GhaOutput"^^xsd:anyURI ;
	linkml:description "An output that a reusable workflow or an action declares for the job or step that calls it to read." ;
	linkml:slot_usage _:c14n22 ;
	linkml:slots <https://w3id.org/lmodel/github-actions/description> , <https://w3id.org/lmodel/github-actions/ghaOutput__output_id> , <https://w3id.org/lmodel/github-actions/output_expression> .
<https://w3id.org/lmodel/github-actions/GhaRepositoryRuleset> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://docs.github.com/en/repositories/configuring-branches-and-merges-in-your-repository/managing-rulesets/available-rules-for-rulesets"^^xsd:anyURI , "https://docs.github.com/en/rest/repos/rules"^^xsd:anyURI ;
	skos:altLabel "ruleset" ;
	skos:exactMatch "gha:RepositoryRuleset"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_rules"^^xsd:anyURI ;
	skos:note "Of the rules' parameters, only those of required_status_checks are modelled, as GhaRequiredStatusCheck; rule_types says which other rules the ruleset holds." , "SLSA's Source track calls such rules technical controls on protected named references, and asks that their meaning be documented and their enforcement recorded in attestations; the slsa schema models that evidence." ;
	linkml:attributes <https://w3id.org/lmodel/github-actions/bypass_actors> , <https://w3id.org/lmodel/github-actions/enforcement> , <https://w3id.org/lmodel/github-actions/ref_name_exclude> , <https://w3id.org/lmodel/github-actions/ref_name_include> , <https://w3id.org/lmodel/github-actions/rule_types> , <https://w3id.org/lmodel/github-actions/ruleset_id> , <https://w3id.org/lmodel/github-actions/ruleset_source> , <https://w3id.org/lmodel/github-actions/ruleset_source_type> , <https://w3id.org/lmodel/github-actions/ruleset_target> , <https://w3id.org/lmodel/github-actions/ruleset_uri> ;
	linkml:class_uri "https://w3id.org/lmodel/github-actions/RepositoryRuleset"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/GhaRepositoryRuleset"^^xsd:anyURI ;
	linkml:description "A ruleset: named rules that GitHub enforces on the branches, tags or pushes of a repository, or of every repository in an organization or enterprise that it targets." ;
	linkml:slot_usage _:c14n11 ;
	linkml:slots <https://w3id.org/lmodel/github-actions/ghaRepositoryRuleset__bypass_actors> , <https://w3id.org/lmodel/github-actions/ghaRepositoryRuleset__enforcement> , <https://w3id.org/lmodel/github-actions/ghaRepositoryRuleset__ref_name_exclude> , <https://w3id.org/lmodel/github-actions/ghaRepositoryRuleset__ref_name_include> , <https://w3id.org/lmodel/github-actions/ghaRepositoryRuleset__rule_types> , <https://w3id.org/lmodel/github-actions/ghaRepositoryRuleset__ruleset_id> , <https://w3id.org/lmodel/github-actions/ghaRepositoryRuleset__ruleset_source> , <https://w3id.org/lmodel/github-actions/ghaRepositoryRuleset__ruleset_source_type> , <https://w3id.org/lmodel/github-actions/ghaRepositoryRuleset__ruleset_target> , <https://w3id.org/lmodel/github-actions/ghaRepositoryRuleset__ruleset_uri> , <https://w3id.org/lmodel/github-actions/requires_check> .
<https://w3id.org/lmodel/github-actions/GhaRequiredMixin> a linkml:ClassDefinition ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_core"^^xsd:anyURI ;
	linkml:attributes <https://w3id.org/lmodel/github-actions/required> ;
	linkml:class_uri "https://w3id.org/lmodel/github-actions/GhaRequiredMixin"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/GhaRequiredMixin"^^xsd:anyURI ;
	linkml:description "The field that says whether a caller must supply a value." ;
	linkml:mixin true ;
	linkml:slot_usage _:c14n5 ;
	linkml:slots <https://w3id.org/lmodel/github-actions/ghaRequiredMixin__required> .
<https://w3id.org/lmodel/github-actions/GhaRequiredStatusCheck> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://docs.github.com/en/pull-requests/collaborating-with-pull-requests/collaborating-on-repositories-with-code-quality-features/about-status-checks"^^xsd:anyURI , "https://docs.github.com/en/pull-requests/collaborating-with-pull-requests/collaborating-on-repositories-with-code-quality-features/troubleshooting-required-status-checks"^^xsd:anyURI , "https://docs.github.com/en/rest/checks/runs"^^xsd:anyURI , "https://docs.github.com/en/rest/repos/rules"^^xsd:anyURI ;
	skos:altLabel "required status check" ;
	skos:exactMatch "gha:RequiredStatusCheck"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_rules"^^xsd:anyURI ;
	skos:note "A job skipped by its own `if`, or because a job it needs failed or was skipped, reports success, so its required check passes without running. A path filter skips the whole run, and a calling job's `if` or `needs` skips the call, which GitHub records under the caller's name alone, so the required check stays pending and blocks the merge. skip_conditions records each of these." , "GitHub Actions reports each job as a check run named after the job: its name, or its id when it has none. A job of a called workflow is named after the calling job and the called job, joined by a slash with a space on each side, as the otterdog documentation states (https://otterdog.readthedocs.io/en/latest/reference/organization/repository/status-check/). A matrix job's check name adds its matrix values in parentheses." , "SLSA's Source track lets an organization carry such a control into a Source Verification Summary Attestation as an ORG_SOURCE_ property, whose meaning the organization defines; slsa-framework's source-tool emits one as GH_REQUIRED_CHECK_ followed by the check's name." , "in-toto's Test Result predicate is the shape of an attestation of what the check found, so it is a related term and not a close one." ;
	skos:relatedMatch "in_toto:test-result/v0.1"^^xsd:anyURI ;
	linkml:attributes <https://w3id.org/lmodel/github-actions/check_context> , <https://w3id.org/lmodel/github-actions/check_uri> , <https://w3id.org/lmodel/github-actions/do_not_enforce_on_create> , <https://w3id.org/lmodel/github-actions/integration_id> , <https://w3id.org/lmodel/github-actions/job_path> , <https://w3id.org/lmodel/github-actions/skip_conditions> , <https://w3id.org/lmodel/github-actions/strict_policy> ;
	linkml:class_uri "https://w3id.org/lmodel/github-actions/RequiredStatusCheck"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/GhaRequiredStatusCheck"^^xsd:anyURI ;
	linkml:description "A status check that a ruleset requires to pass before a change reaches a ref it targets, named by the context a check run must report." ;
	linkml:slot_usage _:c14n25 ;
	linkml:slots <https://w3id.org/lmodel/github-actions/emitted_by> , <https://w3id.org/lmodel/github-actions/ghaRequiredStatusCheck__check_context> , <https://w3id.org/lmodel/github-actions/ghaRequiredStatusCheck__check_uri> , <https://w3id.org/lmodel/github-actions/ghaRequiredStatusCheck__do_not_enforce_on_create> , <https://w3id.org/lmodel/github-actions/ghaRequiredStatusCheck__integration_id> , <https://w3id.org/lmodel/github-actions/ghaRequiredStatusCheck__job_path> , <https://w3id.org/lmodel/github-actions/ghaRequiredStatusCheck__skip_conditions> , <https://w3id.org/lmodel/github-actions/ghaRequiredStatusCheck__strict_policy> , <https://w3id.org/lmodel/github-actions/required_by> .
<https://w3id.org/lmodel/github-actions/GhaReusableWorkflow> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://docs.github.com/en/actions/reference/workflows-and-actions/reusing-workflow-configurations"^^xsd:anyURI , "https://docs.github.com/en/actions/reference/workflows-and-actions/workflow-syntax#onworkflow_call"^^xsd:anyURI ;
	skos:altLabel "reusable workflow" ;
	skos:exactMatch "gha:ReusableWorkflow"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_workflow"^^xsd:anyURI ;
	skos:note "When it generates provenance it is the builder: GitHub's build type sets builder.id to the server's address followed by the job's workflow reference, which names this file and its ref. So lmodel/slsa's SlsaBuildPlatform, the builder that provenance names, is a related term: this project's mapping, and not a close one, because a reusable workflow that generates no provenance is no builder." ;
	skos:relatedMatch "slsa:SlsaBuildPlatform"^^xsd:anyURI ;
	linkml:attributes <https://w3id.org/lmodel/github-actions/secrets> ;
	linkml:class_uri "https://w3id.org/lmodel/github-actions/ReusableWorkflow"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/GhaReusableWorkflow"^^xsd:anyURI ;
	linkml:description "A workflow that other workflows call as a job, because its `on` key names `workflow_call`; it declares the inputs, outputs and secrets its callers pass and read." ;
