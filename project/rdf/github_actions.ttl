	linkml:uri "http://www.w3.org/ns/shex#iri"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/output_expression> a linkml:SlotDefinition ;
	skos:altLabel "value" ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_core"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/github-actions/output_expression"^^xsd:anyURI ;
	skos:note "A slot rather than an attribute because GhaWorkflowOutput refines it." ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/output_expression"^^xsd:anyURI ;
	linkml:description "The expression that sets the output, the file's `value` key, such as one that reads an output of a job or a step." ;
	linkml:domain_of <https://w3id.org/lmodel/github-actions/GhaOutput> ;
	linkml:owner <https://w3id.org/lmodel/github-actions/GhaOutput> ;
	linkml:range <https://w3id.org/lmodel/github-actions/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/github-actions/output_expression"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/output_id> a linkml:SlotDefinition ;
	linkml:description "The key a caller reads the output by." ;
	linkml:range <https://w3id.org/lmodel/github-actions/gha_identifier> ;
	linkml:required true .
<https://w3id.org/lmodel/github-actions/outputs> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_core"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/outputs"^^xsd:anyURI ;
	linkml:description "The outputs that the reusable workflow or the action declares." ;
	linkml:domain_of <https://w3id.org/lmodel/github-actions/GhaAction> , <https://w3id.org/lmodel/github-actions/GhaReusableWorkflow> ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/github-actions/GhaAction> ;
	linkml:range <https://w3id.org/lmodel/github-actions/GhaOutput> ;
	linkml:slot_uri "https://w3id.org/lmodel/github-actions/outputs"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/permissions> a linkml:SlotDefinition ;
	linkml:description "The access the file's top-level `permissions` key gives every job's GITHUB_TOKEN. Absent when the file sets none, so the repository's or organization's default applies; a scope the map leaves out gets no access." ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/github-actions/gha_permission> .
<https://w3id.org/lmodel/github-actions/push> linkml:description "Pushes, by the files they change." .
<https://w3id.org/lmodel/github-actions/ref_name_exclude> a linkml:SlotDefinition ;
	skos:altLabel "exclude" ;
	linkml:description "The refs the ruleset leaves out, from `conditions.ref_name.exclude`, even when they match an included one." ;
	linkml:multivalued true .
<https://w3id.org/lmodel/github-actions/ref_name_include> a linkml:SlotDefinition ;
	skos:altLabel "include" ;
	linkml:description "The refs the ruleset applies to, from `conditions.ref_name.include`: names or patterns such as `refs/heads/main`, or `~DEFAULT_BRANCH` or `~ALL`. A ref must match one of them." ;
	linkml:multivalued true .
<https://w3id.org/lmodel/github-actions/required> a linkml:SlotDefinition ;
	skos:note "An attribute rather than a slot: it carries LOKF's IRI for required, and lokf adapt keeps an attribute's name, where it would rename a slot that shares one with lokf.yaml." ;
	linkml:description "Whether a caller must supply a value." ;
	linkml:range <https://w3id.org/lmodel/github-actions/boolean> ;
	linkml:slot_uri "schema:valueRequired"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/required_by> a linkml:SlotDefinition ;
	owl:inverseOf <https://w3id.org/lmodel/github-actions/requires_check> ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_rules"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/github-actions/required_by"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/required_by"^^xsd:anyURI ;
	linkml:description "The rulesets that require the check." ;
	linkml:domain <https://w3id.org/lmodel/github-actions/GhaRequiredStatusCheck> ;
	linkml:domain_of <https://w3id.org/lmodel/github-actions/GhaRequiredStatusCheck> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/github-actions/GhaRequiredStatusCheck> ;
	linkml:range <https://w3id.org/lmodel/github-actions/GhaRepositoryRuleset> ;
	linkml:slot_uri "https://w3id.org/lmodel/github-actions/required_by"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/required_checks> a linkml:SlotDefinition ;
	linkml:description "The status checks the rulesets require." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/github-actions/GhaRequiredStatusCheck> .
<https://w3id.org/lmodel/github-actions/requires_check> a linkml:SlotDefinition ;
	owl:inverseOf <https://w3id.org/lmodel/github-actions/required_by> ;
	skos:altLabel "required_status_checks" ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_rules"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/github-actions/requires_check"^^xsd:anyURI ;
	skos:note "A slot rather than an attribute because required_by names it as its inverse." ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/requires_check"^^xsd:anyURI ;
	linkml:description "The status checks the ruleset's required_status_checks rule requires, each a concept of its own." ;
	linkml:domain <https://w3id.org/lmodel/github-actions/GhaRepositoryRuleset> ;
	linkml:domain_of <https://w3id.org/lmodel/github-actions/GhaRepositoryRuleset> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/github-actions/GhaRepositoryRuleset> ;
	linkml:range <https://w3id.org/lmodel/github-actions/GhaRequiredStatusCheck> ;
	linkml:slot_uri "https://w3id.org/lmodel/github-actions/requires_check"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/reusable_workflows> a linkml:SlotDefinition ;
	linkml:description "The reusable workflows." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/github-actions/GhaReusableWorkflow> .
<https://w3id.org/lmodel/github-actions/rule_types> a linkml:SlotDefinition ;
	skos:note "A pattern rather than an enumeration, because GitHub adds rule types." ;
	linkml:description "The `type` of each rule the ruleset holds, such as `deletion`, `non_fast_forward`, `pull_request` or `required_status_checks`." ;
	linkml:multivalued true ;
	linkml:pattern "^[a-z_]+$" .
<https://w3id.org/lmodel/github-actions/ruleset_id> a linkml:SlotDefinition ;
	skos:altLabel "id" ;
	linkml:description "The ruleset's numeric `id` in the REST API." ;
	linkml:minimum_value "1"^^linkml:\@id ;
	linkml:range <https://w3id.org/lmodel/github-actions/integer> .
<https://w3id.org/lmodel/github-actions/ruleset_source> a linkml:SlotDefinition ;
	skos:altLabel "source" ;
	linkml:description "The name of the repository, organization or enterprise that owns the ruleset, the REST field `source`, such as `<owner>/<repo>`." .
<https://w3id.org/lmodel/github-actions/ruleset_source_type> a linkml:SlotDefinition ;
	skos:altLabel "source_type" ;
	linkml:description "What owns the ruleset, the REST field `source_type`: a repository, an organization or an enterprise." ;
	linkml:range <https://w3id.org/lmodel/github-actions/GhaRulesetSourceType> .
<https://w3id.org/lmodel/github-actions/ruleset_target> a linkml:SlotDefinition ;
	skos:altLabel "target" ;
	linkml:description "What the ruleset applies to, the REST field `target`. Named ruleset_target because LOKF defines a target slot of its own." ;
	linkml:range <https://w3id.org/lmodel/github-actions/GhaRulesetTarget> ;
	linkml:required true .
<https://w3id.org/lmodel/github-actions/ruleset_uri> a linkml:SlotDefinition ;
	linkml:description "The ruleset's page, the REST response's `_links.html.href`, such as `https://github.com/<owner>/<repo>/rules/<id>`." ;
	linkml:identifier true ;
	linkml:range <https://w3id.org/lmodel/github-actions/uri> .
<https://w3id.org/lmodel/github-actions/rulesets> a linkml:SlotDefinition ;
	linkml:description "The rulesets." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/github-actions/GhaRepositoryRuleset> .
<https://w3id.org/lmodel/github-actions/runner_environment> a linkml:SlotDefinition ;
	linkml:description "Whether the job's runner is hosted by GitHub or by the repository's owner, as GitHub's build type records runner_environment for a run." ;
	linkml:range <https://w3id.org/lmodel/github-actions/GhaRunnerEnvironment> .
<https://w3id.org/lmodel/github-actions/runner_group> a linkml:SlotDefinition ;
	rdfs:seeAlso "https://docs.github.com/en/actions/reference/workflows-and-actions/workflow-syntax#choosing-runners-in-a-group"^^xsd:anyURI ;
	skos:altLabel "group" ;
	linkml:description "The runner group the job's `runs-on.group` names." ;
	linkml:value_presence "ABSENT" .
<https://w3id.org/lmodel/github-actions/runs_on> a linkml:SlotDefinition ;
	rdfs:seeAlso "https://docs.github.com/en/actions/reference/workflows-and-actions/workflow-syntax#jobsjob_idruns-on"^^xsd:anyURI ;
	skos:altLabel "runs-on" ;
	linkml:description "The runner labels from the job's `runs-on`: one label, a list, or the `labels` of a group. A runner must carry every one." ;
	linkml:multivalued true ;
	linkml:value_presence "ABSENT" .
<https://w3id.org/lmodel/github-actions/secret_id> a linkml:SlotDefinition ;
	linkml:description "The key a caller passes the secret under." ;
	linkml:range <https://w3id.org/lmodel/github-actions/gha_identifier> ;
	linkml:required true .
<https://w3id.org/lmodel/github-actions/secrets> a linkml:SlotDefinition ;
	linkml:description "The secrets under the file's `on.workflow_call.secrets` key, by name only; no value is ever recorded." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/github-actions/GhaWorkflowSecret> .
<https://w3id.org/lmodel/github-actions/self-hosted> dcterms:title "Self-hosted" ;
	linkml:description "A runner that the repository's owner hosts." .
<https://w3id.org/lmodel/github-actions/skip_conditions> a linkml:SlotDefinition ;
	linkml:description "What in the workflow can skip the job that reports the check, each written as its key's path in the file, such as `on.pull_request.paths` or `jobs.test.if`." ;
	linkml:multivalued true ;
	linkml:pattern "^(on|jobs)\\.\\S+$" .
<https://w3id.org/lmodel/github-actions/sparqlpath> dcterms:conformsTo "https://www.w3.org/TR/sparql11-query/#propertypaths" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"sparqlpath\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/Sparqlpath"^^xsd:anyURI ;
	linkml:description "A string encoding a SPARQL Property Path. The value of the string MUST conform to SPARQL syntax and SHOULD dereference to zero or more valid objects within the current instance document when encoded as RDF." ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/strict_policy> a linkml:SlotDefinition ;
	skos:altLabel "strict_required_status_checks_policy" ;
	linkml:description "Whether a pull request must be tested against the latest code of the branch it targets, the rule's `strict_required_status_checks_policy`." ;
	linkml:range <https://w3id.org/lmodel/github-actions/boolean> .
<https://w3id.org/lmodel/github-actions/string> a linkml:TypeDefinition ;
	skos:editorialNote "In RDF serializations, a slot with range of string is treated as a literal or type xsd:string. If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"string\"." ;
	skos:exactMatch "schema:Text"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/String"^^xsd:anyURI ;
	linkml:description "A character string" , "A string." ;
	linkml:imported_from "linkml:types" ;
	linkml:meaning "xsd:string"^^xsd:anyURI ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/tag> linkml:description "Tags." .
<https://w3id.org/lmodel/github-actions/time> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"time\"." , "URI is dateTime because OWL reasoners do not work with straight date or time" ;
	skos:exactMatch "schema:Time"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "XSDTime" ;
	linkml:definition_uri "https://w3id.org/linkml/Time"^^xsd:anyURI ;
	linkml:description "A time object represents a (local) time of day, independent of any particular day" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#time"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/triggers> a linkml:SlotDefinition ;
	rdfs:seeAlso "https://docs.github.com/en/actions/reference/workflows-and-actions/events-that-trigger-workflows"^^xsd:anyURI ;
	skos:altLabel "on" ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_workflow"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/github-actions/triggers"^^xsd:anyURI ;
	skos:note "A slot rather than an attribute because GhaReusableWorkflow refines it; a pattern rather than an enumeration, because GitHub adds events." ;
	skos:relatedMatch "http://cyclonedx.org/schema/bom-1.7.schema.json#/definitions/trigger"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/triggers"^^xsd:anyURI ;
	linkml:description "The names of the events under the file's `on` key, such as `push`, `pull_request`, `schedule` or `workflow_call`." ;
	linkml:domain_of <https://w3id.org/lmodel/github-actions/GhaWorkflow> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/github-actions/GhaWorkflow> ;
	linkml:pattern "^[a-z_]+$" ;
	linkml:range <https://w3id.org/lmodel/github-actions/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/github-actions/triggers"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/uri> dcterms:conformsTo "https://www.ietf.org/rfc/rfc3987.txt" ;
	a linkml:TypeDefinition ;
	skos:closeMatch "schema:URL"^^xsd:anyURI ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uri\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	skos:note "in RDF serializations a slot with range of uri is treated as a literal or type xsd:anyURI unless it is an identifier or a reference to an identifier, in which case it is translated directly to a node" ;
	linkml:base "URI" ;
	linkml:definition_uri "https://w3id.org/linkml/Uri"^^xsd:anyURI ;
	linkml:description "a complete URI" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#anyURI"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/uriorcurie> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"uriorcurie\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "URIorCURIE" ;
	linkml:definition_uri "https://w3id.org/linkml/Uriorcurie"^^xsd:anyURI ;
	linkml:description "a URI or a CURIE" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#anyURI"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/using> a linkml:SlotDefinition ;
	linkml:description "The runtime that executes the action, its `runs.using` value." ;
	linkml:range <https://w3id.org/lmodel/github-actions/GhaActionRuntime> ;
	linkml:required true .
<https://w3id.org/lmodel/github-actions/workflow_path> a linkml:SlotDefinition ;
	rdfs:seeAlso "https://actions.github.io/buildtypes/workflow/v1"^^xsd:anyURI ;
	linkml:description "The file's path from the repository root, as GitHub's build type writes workflow.path. GitHub reads no subdirectory of `.github/workflows`." ;
	linkml:pattern "^\\.github/workflows/[^/]+\\.ya?ml$" ;
	linkml:required true .
<https://w3id.org/lmodel/github-actions/workflow_repository> a linkml:SlotDefinition ;
	rdfs:seeAlso "https://actions.github.io/buildtypes/workflow/v1"^^xsd:anyURI ;
	skos:closeMatch "schema:codeRepository"^^xsd:anyURI ;
	linkml:description "The repository that holds the file, as GitHub's build type writes workflow.repository: an HTTPS address without `.git`." ;
	linkml:pattern "^https://[^/]+/[^/]+/[^/]+$" ;
	linkml:range <https://w3id.org/lmodel/github-actions/uri> .
<https://w3id.org/lmodel/github-actions/workflow_uri> a linkml:SlotDefinition ;
	skos:note "GitHub's build type forms a reusable workflow's builder.id from this address, followed by `@` and the ref." ;
	linkml:description "The file's address on its forge without a ref: `https://github.com/<owner>/<repo>/.github/workflows/<file>`." ;
	linkml:identifier true ;
	linkml:range <https://w3id.org/lmodel/github-actions/uri> .
<https://w3id.org/lmodel/github-actions/workflows> a linkml:SlotDefinition ;
	linkml:description "The workflows other than the reusable ones." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/github-actions/GhaWorkflow> .
_:c14n0 skos:example "2026-10-28" ;
	linkml:tag "docs_read"^^xsd:anyURI .
_:c14n1 skos:example "2026-03-10" ;
	linkml:tag "rest_api_version"^^xsd:anyURI .
_:c14n10 sh:namespace "https://w3id.org/lmodel/github-actions/"^^xsd:anyURI ;
	sh:prefix "gha" .
_:c14n13 skos:example "f7c2f3bcb512651bd980ed6896639ea8ded9ddf0" ;
	linkml:tag "schemastore_commit"^^xsd:anyURI .
_:c14n14 sh:namespace "https://w3id.org/linkml/"^^xsd:anyURI ;
	sh:prefix "linkml" .
_:c14n19 a linkml:AnonymousSlotExpression ;
	linkml:equals_string "workflow_call" .
_:c14n20 a linkml:ClassRule ;
	sh:condition _:c14n26 ;
	linkml:description "A job that calls a reusable workflow names no runner group." ;
	linkml:postconditions _:c14n3 .
_:c14n21 a linkml:ClassRule ;
	sh:condition _:c14n27 ;
	linkml:description "A job that calls a reusable workflow names no runner labels: a calling job takes no `runs-on` key, and the called workflow's jobs choose their own runners." ;
	linkml:postconditions _:c14n24 .
_:c14n24 a linkml:AnonymousClassExpression ;
	linkml:slot_conditions <https://w3id.org/lmodel/github-actions/runs_on> .
_:c14n26 a linkml:AnonymousClassExpression ;
	linkml:slot_conditions <https://w3id.org/lmodel/github-actions/calls> .
_:c14n27 a linkml:AnonymousClassExpression ;
	linkml:slot_conditions <https://w3id.org/lmodel/github-actions/calls> .
_:c14n3 a linkml:AnonymousClassExpression ;
	linkml:slot_conditions <https://w3id.org/lmodel/github-actions/runner_group> .

