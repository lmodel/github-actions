	linkml:owner <https://w3id.org/lmodel/github-actions/GhaBypassActor> ;
	linkml:pattern "^[A-Z][A-Za-z]+$" ;
	linkml:range <https://w3id.org/lmodel/github-actions/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/github-actions/actor_type"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/ghaBypassActor__bypass_mode> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_rules"^^xsd:anyURI ;
