<https://w3id.org/lmodel/github-actions/Enterprise> linkml:description "An enterprise's ruleset, applied to the repositories it targets." .
<https://w3id.org/lmodel/github-actions/GhaAction> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://docs.github.com/en/actions/reference/workflows-and-actions/metadata-syntax"^^xsd:anyURI ;
	skos:altLabel "action" ;
	skos:broadMatch "schema:SoftwareSourceCode"^^xsd:anyURI ;
	skos:closeMatch "cdx:task"^^xsd:anyURI ;
	skos:exactMatch "gha:Action"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_action"^^xsd:anyURI ;
	skos:note "SLSA counts the actions a build runs among its steps, which the tenant defines; an action is never a build's trust boundary, as a reusable workflow that signs provenance is." , "The mapping to schema.org is this project's own: an action is code in a repository, of which schema.org's SoftwareSourceCode is the broader term." , "The metadata file's name and description are the concept's title and description in a knowledge bundle, so the class adds neither." ;
	linkml:attributes <https://w3id.org/lmodel/github-actions/action_path> , <https://w3id.org/lmodel/github-actions/action_uri> , <https://w3id.org/lmodel/github-actions/using> ;
	linkml:class_uri "https://w3id.org/lmodel/github-actions/Action"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/GhaAction"^^xsd:anyURI ;
	linkml:description "An action: a directory whose `action.yml` or `action.yaml` file names its inputs, its outputs and the runtime that executes it. A workflow step runs it with `uses`." ;
	linkml:slot_usage _:c14n16 ;
	linkml:slots <https://w3id.org/lmodel/github-actions/GhaAction_inputs> , <https://w3id.org/lmodel/github-actions/GhaAction_outputs> , <https://w3id.org/lmodel/github-actions/ghaAction__action_path> , <https://w3id.org/lmodel/github-actions/ghaAction__action_uri> , <https://w3id.org/lmodel/github-actions/ghaAction__using> .
<https://w3id.org/lmodel/github-actions/GhaActionInput> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://docs.github.com/en/actions/reference/workflows-and-actions/metadata-syntax#inputs"^^xsd:anyURI ;
	skos:exactMatch "gha:ActionInput"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_action"^^xsd:anyURI ;
	linkml:attributes <https://w3id.org/lmodel/github-actions/deprecation_message> ;
	linkml:class_uri "https://w3id.org/lmodel/github-actions/ActionInput"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/GhaActionInput"^^xsd:anyURI ;
	linkml:description "An input under an action's `inputs` key." ;
	linkml:is_a <https://w3id.org/lmodel/github-actions/GhaInput> ;
	linkml:slot_usage _:c14n2 ;
	linkml:slots <https://w3id.org/lmodel/github-actions/GhaActionInput_description> , <https://w3id.org/lmodel/github-actions/ghaActionInput__deprecation_message> , <https://w3id.org/lmodel/github-actions/ghaInput__default> , <https://w3id.org/lmodel/github-actions/ghaInput__input_id> , <https://w3id.org/lmodel/github-actions/ghaRequiredMixin__required> .
<https://w3id.org/lmodel/github-actions/GhaActionInput_description> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_core"^^xsd:anyURI ;
	skos:mappingRelation "http://schema.org/description"^^xsd:anyURI ;
	skos:note "It means what LOKF's description means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one description key." ;
	skos:prefLabel "description" ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/description"^^xsd:anyURI ;
	linkml:description "What the input, output or secret is for, as the file describes it." ;
	linkml:domain <https://w3id.org/lmodel/github-actions/GhaActionInput> ;
	linkml:domain_of <https://w3id.org/lmodel/github-actions/GhaActionInput> ;
	linkml:is_a <https://w3id.org/lmodel/github-actions/description> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/github-actions/GhaActionInput> ;
	linkml:range <https://w3id.org/lmodel/github-actions/string> ;
	linkml:required true ;
	linkml:slot_uri "http://schema.org/description"^^xsd:anyURI ;
	linkml:usage_slot_name "description" .
<https://w3id.org/lmodel/github-actions/GhaActionOutput> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://docs.github.com/en/actions/reference/workflows-and-actions/metadata-syntax#outputs-for-composite-actions"^^xsd:anyURI , "https://docs.github.com/en/actions/reference/workflows-and-actions/metadata-syntax#outputs-for-docker-container-and-javascript-actions"^^xsd:anyURI ;
	skos:exactMatch "gha:ActionOutput"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_action"^^xsd:anyURI ;
	skos:note "Only a composite action sets an output from an expression; a Docker or JavaScript action writes its outputs while it runs, so its outputs have no output_expression." ;
	linkml:class_uri "https://w3id.org/lmodel/github-actions/ActionOutput"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/GhaActionOutput"^^xsd:anyURI ;
	linkml:description "An output under an action's `outputs` key." ;
	linkml:is_a <https://w3id.org/lmodel/github-actions/GhaOutput> ;
	linkml:slot_usage _:c14n6 ;
	linkml:slots <https://w3id.org/lmodel/github-actions/GhaActionOutput_description> , <https://w3id.org/lmodel/github-actions/ghaOutput__output_id> , <https://w3id.org/lmodel/github-actions/output_expression> .
<https://w3id.org/lmodel/github-actions/GhaActionOutput_description> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_core"^^xsd:anyURI ;
	skos:mappingRelation "http://schema.org/description"^^xsd:anyURI ;
	skos:note "It means what LOKF's description means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one description key." ;
	skos:prefLabel "description" ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/description"^^xsd:anyURI ;
	linkml:description "What the input, output or secret is for, as the file describes it." ;
	linkml:domain <https://w3id.org/lmodel/github-actions/GhaActionOutput> ;
	linkml:domain_of <https://w3id.org/lmodel/github-actions/GhaActionOutput> ;
	linkml:is_a <https://w3id.org/lmodel/github-actions/description> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/github-actions/GhaActionOutput> ;
	linkml:range <https://w3id.org/lmodel/github-actions/string> ;
	linkml:required true ;
	linkml:slot_uri "http://schema.org/description"^^xsd:anyURI ;
	linkml:usage_slot_name "description" .
<https://w3id.org/lmodel/github-actions/GhaActionRuntime> rdfs:seeAlso "https://docs.github.com/en/actions/reference/workflows-and-actions/metadata-syntax#runs-for-composite-actions"^^xsd:anyURI , "https://docs.github.com/en/actions/reference/workflows-and-actions/metadata-syntax#runs-for-docker-container-actions"^^xsd:anyURI , "https://docs.github.com/en/actions/reference/workflows-and-actions/metadata-syntax#runs-for-javascript-actions"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_action"^^xsd:anyURI ;
	skos:note "SchemaStore's schema at the pinned commit also accepts node12 and node16, which GitHub's metadata syntax page no longer lists; tests/test_schema_rules.py checks that those two are the only difference." ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/GhaActionRuntime"^^xsd:anyURI ;
	linkml:description "The runtimes an action's `runs.using` may name." ;
	linkml:permissible_values <https://w3id.org/lmodel/github-actions/composite> , <https://w3id.org/lmodel/github-actions/docker> , <https://w3id.org/lmodel/github-actions/node20> , <https://w3id.org/lmodel/github-actions/node24> .
<https://w3id.org/lmodel/github-actions/GhaAction_inputs> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_core"^^xsd:anyURI ;
