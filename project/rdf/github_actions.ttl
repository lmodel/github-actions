	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/github-actions/GhaWorkflowJob> ;
	linkml:range <https://w3id.org/lmodel/github-actions/gha_permission> ;
	linkml:slot_uri "https://w3id.org/lmodel/github-actions/job_permissions"^^xsd:anyURI .
