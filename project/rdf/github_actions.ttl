	linkml:range <https://w3id.org/lmodel/github-actions/uri> ;
	linkml:slot_uri "https://w3id.org/lmodel/github-actions/workflow_repository"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/ghaWorkflow__workflow_uri> a linkml:SlotDefinition ;
