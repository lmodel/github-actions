	skos:relatedMatch "http://cyclonedx.org/schema/bom-1.7.schema.json#/definitions/trigger"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/triggers"^^xsd:anyURI ;
	linkml:description "The names of the events under the file's `on` key, such as `push`, `pull_request`, `schedule` or `workflow_call`." ;
