	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/github-actions/using"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/ghaBypassActor__actor_id> a linkml:SlotDefinition ;
