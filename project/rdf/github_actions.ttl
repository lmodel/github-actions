	linkml:definition_uri "https://w3id.org/lmodel/github-actions/output_expression"^^xsd:anyURI ;
	linkml:description "The expression that sets the output, the file's `value` key, such as one that reads an output of a job or a step." ;
	linkml:domain <https://w3id.org/lmodel/github-actions/GhaWorkflowOutput> ;
	linkml:domain_of <https://w3id.org/lmodel/github-actions/GhaWorkflowOutput> ;
	linkml:is_a <https://w3id.org/lmodel/github-actions/output_expression> ;
	linkml:is_usage_slot true ;
	linkml:owner <https://w3id.org/lmodel/github-actions/GhaWorkflowOutput> ;
	linkml:range <https://w3id.org/lmodel/github-actions/string> ;
	linkml:required true ;
	linkml:slot_uri "https://w3id.org/lmodel/github-actions/output_expression"^^xsd:anyURI ;
	linkml:usage_slot_name "output_expression" .
<https://w3id.org/lmodel/github-actions/GhaWorkflowSecret> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://docs.github.com/en/actions/reference/workflows-and-actions/workflow-syntax#onworkflow_callsecrets"^^xsd:anyURI ;
