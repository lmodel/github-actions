<https://w3id.org/lmodel/github-actions/GhaWorkflowInputType> rdfs:seeAlso "https://docs.github.com/en/actions/reference/workflows-and-actions/workflow-syntax#onworkflow_callinputsinput_idtype"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_workflow"^^xsd:anyURI ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/GhaWorkflowInputType"^^xsd:anyURI ;
	linkml:description "The types a reusable workflow's input may state." ;
	linkml:permissible_values <https://w3id.org/lmodel/github-actions/boolean> , <https://w3id.org/lmodel/github-actions/number> , <https://w3id.org/lmodel/github-actions/string> .
<https://w3id.org/lmodel/github-actions/GhaWorkflowJob> a linkml:ClassDefinition ;
	rdfs:seeAlso "https://docs.github.com/en/actions/reference/workflows-and-actions/workflow-syntax#jobs"^^xsd:anyURI ;
	skos:altLabel "job" ;
	skos:closeMatch "cdx:task"^^xsd:anyURI ;
	skos:exactMatch "gha:WorkflowJob"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_workflow"^^xsd:anyURI ;
	skos:note "The mapping is this project's own: CycloneDX makes a workflow of tasks, as a GitHub workflow is made of jobs." ;
	sh:rule _:c14n20 , _:c14n21 ;
	linkml:attributes <https://w3id.org/lmodel/github-actions/calls> , <https://w3id.org/lmodel/github-actions/job_id> , <https://w3id.org/lmodel/github-actions/job_name> , <https://w3id.org/lmodel/github-actions/job_permissions> , <https://w3id.org/lmodel/github-actions/runner_environment> , <https://w3id.org/lmodel/github-actions/runner_group> , <https://w3id.org/lmodel/github-actions/runs_on> ;
