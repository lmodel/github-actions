	linkml:slot_uri "https://w3id.org/lmodel/github-actions/job_name"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/ghaWorkflowJob__job_permissions> a linkml:SlotDefinition ;
	rdfs:seeAlso "https://docs.github.com/en/actions/reference/workflows-and-actions/workflow-syntax#jobsjob_idpermissions"^^xsd:anyURI ;
