	linkml:slot_uri "https://w3id.org/lmodel/github-actions/do_not_enforce_on_create"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/ghaRequiredStatusCheck__integration_id> a linkml:SlotDefinition ;
