<https://w3id.org/lmodel/github-actions/Organization> linkml:description "An organization's ruleset, applied to the repositories it targets." .
<https://w3id.org/lmodel/github-actions/Repository> linkml:description "A repository's own ruleset." .
<https://w3id.org/lmodel/github-actions/action_path> a linkml:SlotDefinition ;
	linkml:description "The metadata file's path from the repository root." ;
	linkml:pattern "^(.+/)?action\\.ya?ml$" ;
	linkml:required true .
<https://w3id.org/lmodel/github-actions/action_uri> a linkml:SlotDefinition ;
	linkml:description "The action's address on its forge without a ref: `https://github.com/<owner>/<repo>`, followed by the directory's path when the action is not at the repository root. A step's `uses` names it as `<owner>/<repo>/<path>@<ref>`." ;
	linkml:identifier true ;
	linkml:range <https://w3id.org/lmodel/github-actions/uri> .
<https://w3id.org/lmodel/github-actions/actions> a linkml:SlotDefinition ;
	linkml:description "The actions." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/github-actions/GhaAction> .
<https://w3id.org/lmodel/github-actions/active> linkml:description "Enforced." .
<https://w3id.org/lmodel/github-actions/actor_id> a linkml:SlotDefinition ;
	linkml:description "The actor's numeric id; absent for an actor type GitHub takes no id for, such as DeployKey or OrganizationAdmin." ;
	linkml:range <https://w3id.org/lmodel/github-actions/integer> .
<https://w3id.org/lmodel/github-actions/actor_type> a linkml:SlotDefinition ;
	skos:note "A pattern rather than an enumeration, because GitHub adds actor types." ;
	linkml:description "The kind of actor, the REST field `actor_type`, such as `Team`, `RepositoryRole`, `Integration` or `OrganizationAdmin`." ;
	linkml:pattern "^[A-Z][A-Za-z]+$" ;
	linkml:required true .
<https://w3id.org/lmodel/github-actions/boolean> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"boolean\"." ;
	skos:exactMatch "schema:Boolean"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "Bool" ;
	linkml:definition_uri "https://w3id.org/linkml/Boolean"^^xsd:anyURI ;
	linkml:description "A binary (true or false) value" , "True or false." ;
	linkml:imported_from "linkml:types" ;
	linkml:meaning "xsd:boolean"^^xsd:anyURI ;
	linkml:repr "bool" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#boolean"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/branch> linkml:description "Branches; GitHub's default." .
<https://w3id.org/lmodel/github-actions/bypass_actors> a linkml:SlotDefinition ;
	linkml:description "The actors who may bypass the ruleset." ;
	linkml:inlined true ;
	linkml:inlined_as_list true ;
	linkml:multivalued true ;
	linkml:range <https://w3id.org/lmodel/github-actions/GhaBypassActor> .
<https://w3id.org/lmodel/github-actions/bypass_mode> a linkml:SlotDefinition ;
	skos:note "A pattern rather than an enumeration, because GitHub adds bypass modes." ;
	linkml:description "When the actor may bypass, the REST field `bypass_mode`, such as `always`, `pull_request` or `exempt`; GitHub's default is `always`." ;
	linkml:pattern "^[a-z_]+$" .
<https://w3id.org/lmodel/github-actions/calls> a linkml:SlotDefinition ;
	rdfs:seeAlso "https://docs.github.com/en/actions/reference/workflows-and-actions/workflow-syntax#jobsjob_iduses"^^xsd:anyURI ;
	skos:altLabel "uses" ;
	linkml:description "The reusable workflow the job runs, its `uses` value: `./.github/workflows/<file>` in the same repository, or `<owner>/<repo>/.github/workflows/<file>@<ref>`." ;
	linkml:pattern "^(.+\\/)+(.+)\\.(ya?ml)(@.+)?$" ;
	linkml:value_presence "PRESENT" .
<https://w3id.org/lmodel/github-actions/check_context> a linkml:SlotDefinition ;
	skos:altLabel "context" ;
	linkml:description "The context a check run must report, the rule's `required_status_checks[].context`. Named check_context because LOKF defines a context slot of its own." ;
	linkml:pattern "\\S" ;
	linkml:required true .
<https://w3id.org/lmodel/github-actions/check_uri> a linkml:SlotDefinition ;
	linkml:description "An identifier for the requirement. GitHub gives a required check no address of its own; in a knowledge bundle the concept's `id` takes its place." ;
	linkml:identifier true ;
	linkml:range <https://w3id.org/lmodel/github-actions/uri> .
<https://w3id.org/lmodel/github-actions/composite> linkml:description "Steps that run in the calling job, as a workflow's steps do." .
<https://w3id.org/lmodel/github-actions/curie> dcterms:conformsTo "https://www.w3.org/TR/curie/" ;
	a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"curie\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	skos:note "in RDF serializations this MUST be expanded to a URI" , "in non-RDF serializations MAY be serialized as the compact representation" ;
	linkml:base "Curie" ;
	linkml:definition_uri "https://w3id.org/linkml/Curie"^^xsd:anyURI ;
	linkml:description "a compact URI" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#string"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/date> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date\"." , "URI is dateTime because OWL reasoners don't work with straight date or time" ;
	skos:exactMatch "schema:Date"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "XSDDate" ;
	linkml:definition_uri "https://w3id.org/linkml/Date"^^xsd:anyURI ;
	linkml:description "a date (year, month and day) in an idealized calendar" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#date"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/date_or_datetime> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"date_or_datetime\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "str" ;
	linkml:definition_uri "https://w3id.org/linkml/DateOrDatetime"^^xsd:anyURI ;
	linkml:description "Either a date or a datetime" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "https://w3id.org/linkml/DateOrDatetime"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/datetime> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"datetime\"." ;
	skos:exactMatch "schema:DateTime"^^xsd:anyURI ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "XSDDateTime" ;
	linkml:definition_uri "https://w3id.org/linkml/Datetime"^^xsd:anyURI ;
	linkml:description "The combination of a date and time" ;
	linkml:imported_from "linkml:types" ;
	linkml:repr "str" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#dateTime"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/decimal> a linkml:TypeDefinition ;
	skos:broadMatch "schema:Number"^^xsd:anyURI ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"decimal\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "Decimal" ;
	linkml:definition_uri "https://w3id.org/linkml/Decimal"^^xsd:anyURI ;
	linkml:description "A real number with arbitrary precision that conforms to the xsd:decimal specification" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#decimal"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/default> a linkml:SlotDefinition ;
	skos:exactMatch "schema:defaultValue"^^xsd:anyURI ;
	linkml:description "The value used when a caller supplies none, written as a string even where the input's type is a boolean or a number." .
<https://w3id.org/lmodel/github-actions/deprecation_message> a linkml:SlotDefinition ;
	rdfs:seeAlso "https://docs.github.com/en/actions/reference/workflows-and-actions/metadata-syntax#inputsinput_iddeprecationmessage"^^xsd:anyURI ;
	skos:altLabel "deprecationMessage" ;
	linkml:description "The message GitHub shows a workflow that still passes the input, the file's `deprecationMessage`; present only when the input is deprecated." .
<https://w3id.org/lmodel/github-actions/description> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_core"^^xsd:anyURI ;
	skos:mappingRelation "http://schema.org/description"^^xsd:anyURI ;
	skos:note "It means what LOKF's description means and carries the same IRI, so lokf adapt folds it into LOKF's slot and a knowledge bundle reads one description key." ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/description"^^xsd:anyURI ;
	linkml:description "What the input, output or secret is for, as the file describes it." ;
	linkml:domain_of <https://w3id.org/lmodel/github-actions/GhaInput> , <https://w3id.org/lmodel/github-actions/GhaOutput> , <https://w3id.org/lmodel/github-actions/GhaWorkflowSecret> ;
	linkml:owner <https://w3id.org/lmodel/github-actions/GhaWorkflowSecret> ;
	linkml:range <https://w3id.org/lmodel/github-actions/string> ;
	linkml:slot_uri "http://schema.org/description"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/disabled> linkml:description "Neither enforced nor evaluated." .
<https://w3id.org/lmodel/github-actions/do_not_enforce_on_create> a linkml:SlotDefinition ;
	linkml:description "Whether a branch may be created although the check would otherwise stop it, the rule's `do_not_enforce_on_create`." ;
	linkml:range <https://w3id.org/lmodel/github-actions/boolean> .
<https://w3id.org/lmodel/github-actions/docker> linkml:description "A Docker container." .
<https://w3id.org/lmodel/github-actions/double> a linkml:TypeDefinition ;
	skos:closeMatch "schema:Float"^^xsd:anyURI ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"double\"." ;
	skos:inScheme "https://w3id.org/linkml/types"^^xsd:anyURI ;
	linkml:base "float" ;
	linkml:definition_uri "https://w3id.org/linkml/Double"^^xsd:anyURI ;
	linkml:description "A real number that conforms to the xsd:double specification" ;
	linkml:imported_from "linkml:types" ;
	linkml:uri "http://www.w3.org/2001/XMLSchema#double"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/emits_check> a linkml:SlotDefinition ;
	owl:inverseOf <https://w3id.org/lmodel/github-actions/emitted_by> ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_rules"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/github-actions/emits_check"^^xsd:anyURI ;
	skos:note "No class lists it: GhaWorkflow would need the workflow module to import this one, which imports it. A document states the link from the check's side, with emitted_by, and the ontology states the pair, so a reasoner reads it from the workflow's side too." ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/emits_check"^^xsd:anyURI ;
	linkml:description "The required status checks that the workflow's jobs report." ;
	linkml:domain <https://w3id.org/lmodel/github-actions/GhaWorkflow> ;
	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/github-actions/emits_check> ;
	linkml:range <https://w3id.org/lmodel/github-actions/GhaRequiredStatusCheck> ;
	linkml:slot_uri "https://w3id.org/lmodel/github-actions/emits_check"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/emitted_by> a linkml:SlotDefinition ;
	owl:inverseOf <https://w3id.org/lmodel/github-actions/emits_check> ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_rules"^^xsd:anyURI ;
	skos:mappingRelation "https://w3id.org/lmodel/github-actions/emitted_by"^^xsd:anyURI ;
	skos:note "A slot rather than an attribute because emits_check names it as its inverse." ;
	linkml:definition_uri "https://w3id.org/lmodel/github-actions/emitted_by"^^xsd:anyURI ;
	linkml:description "The top-level workflow whose job reports the check." ;
	linkml:domain <https://w3id.org/lmodel/github-actions/GhaRequiredStatusCheck> ;
	linkml:domain_of <https://w3id.org/lmodel/github-actions/GhaRequiredStatusCheck> ;
	linkml:owner <https://w3id.org/lmodel/github-actions/GhaRequiredStatusCheck> ;
	linkml:range <https://w3id.org/lmodel/github-actions/GhaWorkflow> ;
	linkml:slot_uri "https://w3id.org/lmodel/github-actions/emitted_by"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/enforcement> a linkml:SlotDefinition ;
	linkml:description "Whether GitHub enforces the ruleset, the REST field `enforcement`." ;
	linkml:range <https://w3id.org/lmodel/github-actions/GhaRulesetEnforcement> ;
	linkml:required true .
<https://w3id.org/lmodel/github-actions/evaluate> linkml:description "Evaluated and reported but not enforced, so administrators can test its rules; only on GitHub Enterprise." .
<https://w3id.org/lmodel/github-actions/float> a linkml:TypeDefinition ;
	skos:editorialNote "If you are authoring schemas in LinkML YAML, the type is referenced with the lower case \"float\"." ;
