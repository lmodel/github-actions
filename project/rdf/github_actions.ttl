	linkml:slots <https://w3id.org/lmodel/github-actions/ghaWorkflowJob__calls> , <https://w3id.org/lmodel/github-actions/ghaWorkflowJob__job_id> , <https://w3id.org/lmodel/github-actions/ghaWorkflowJob__job_name> , <https://w3id.org/lmodel/github-actions/ghaWorkflowJob__job_permissions> , <https://w3id.org/lmodel/github-actions/ghaWorkflowJob__runner_environment> , <https://w3id.org/lmodel/github-actions/ghaWorkflowJob__runner_group> , <https://w3id.org/lmodel/github-actions/ghaWorkflowJob__runs_on> , <https://w3id.org/lmodel/github-actions/job_of> .
<https://w3id.org/lmodel/github-actions/GhaWorkflowOutput> a linkml:ClassDefinition ;
