	linkml:multivalued true ;
	linkml:owner <https://w3id.org/lmodel/github-actions/GhaWorkflowJob> ;
	linkml:range <https://w3id.org/lmodel/github-actions/string> ;
	linkml:slot_uri "https://w3id.org/lmodel/github-actions/runs_on"^^xsd:anyURI .
<https://w3id.org/lmodel/github-actions/ghaWorkflowSecret__secret_id> a linkml:SlotDefinition ;
