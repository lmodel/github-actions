<https://w3id.org/lmodel/github-actions/ghaBypassActor__actor_type> a linkml:SlotDefinition ;
	skos:inScheme "https://w3id.org/lmodel/github-actions/github_actions_rules"^^xsd:anyURI ;
	skos:note "A pattern rather than an enumeration, because GitHub adds actor types." ;
	skos:prefLabel "actor_type" ;
	linkml:description "The kind of actor, the REST field `actor_type`, such as `Team`, `RepositoryRole`, `Integration` or `OrganizationAdmin`." ;
