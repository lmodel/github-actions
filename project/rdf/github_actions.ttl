<https://w3id.org/lmodel/github-actions/gha_permission> a linkml:TypeDefinition ;
	rdfs:seeAlso "https://docs.github.com/en/actions/reference/workflows-and-actions/workflow-syntax#permissions"^^xsd:anyURI ;
